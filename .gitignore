# --- Rust -------------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb

# Cargo.lock is committed on purpose: this is an application, and CI/release
# builds use `--locked` so every release is reproducible.

# --- Release packaging (created by .github/workflows/release.yml) -----------
/dist/

# --- Local vaults & test data: never commit secrets ------------------------
*.seepass
*.seepass.bak
*.seepass.tmp-*
/demo/
settings.json
!/tests/fixtures/**

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Legacy C# (SeePass 7.x) build output, kept for reference only ---------
legacy/**/bin/
legacy/**/obj/
legacy/**/.vs/
legacy/**/packages/
legacy/**/*.user
legacy/**/*.suo
